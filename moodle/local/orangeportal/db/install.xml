<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="local/orangeportal/db" VERSION="20261020" COMMENT="Orange portal">
  <TABLES>
    <TABLE NAME="local_orange_doc_read" COMMENT="Personal views of Orange library resources">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="cmid" TYPE="int" LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="readtime" TYPE="int" LENGTH="10" NOTNULL="true"/>
      </FIELDS>
      <KEYS><KEY NAME="primary" TYPE="primary" FIELDS="id"/><KEY NAME="user" TYPE="foreign" FIELDS="userid" REFTABLE="user" REFFIELDS="id"/><KEY NAME="module" TYPE="foreign" FIELDS="cmid" REFTABLE="course_modules" REFFIELDS="id"/></KEYS>
      <INDEXES><INDEX NAME="usermodule" UNIQUE="true" FIELDS="userid,cmid"/></INDEXES>
    </TABLE>
    <TABLE NAME="local_orange_category" COMMENT="Editable notice category tree">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="kind" TYPE="char" LENGTH="20" NOTNULL="true"/>
        <FIELD NAME="name" TYPE="char" LENGTH="255" NOTNULL="true"/>
        <FIELD NAME="parentid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
      </FIELDS>
      <KEYS><KEY NAME="primary" TYPE="primary" FIELDS="id"/></KEYS>
      <INDEXES><INDEX NAME="kindparent" UNIQUE="false" FIELDS="kind,parentid"/></INDEXES>
    </TABLE>
    <TABLE NAME="local_orange_notice" COMMENT="Operational incidents and announcements">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="kind" TYPE="char" LENGTH="20" NOTNULL="true"/>
        <FIELD NAME="categoryid" TYPE="int" LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="title" TYPE="char" LENGTH="255" NOTNULL="true"/>
        <FIELD NAME="content" TYPE="text" NOTNULL="true"/>
        <FIELD NAME="client" TYPE="char" LENGTH="255" NOTNULL="true" DEFAULT=""/>
        <FIELD NAME="product" TYPE="char" LENGTH="255" NOTNULL="true" DEFAULT=""/>
        <FIELD NAME="timeclosed" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="closedby" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="deleted" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="deletedby" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="impact" TYPE="char" LENGTH="20" NOTNULL="true" DEFAULT="normal"/>
        <FIELD NAME="state" TYPE="char" LENGTH="20" NOTNULL="true" DEFAULT="open"/>
        <FIELD NAME="published" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="revision" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="1"/>
        <FIELD NAME="authorid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true"/>
      </FIELDS>
      <KEYS><KEY NAME="primary" TYPE="primary" FIELDS="id"/><KEY NAME="category" TYPE="foreign" FIELDS="categoryid" REFTABLE="local_orange_category" REFFIELDS="id"/></KEYS>
      <INDEXES><INDEX NAME="kindpublished" UNIQUE="false" FIELDS="kind,published"/></INDEXES>
    </TABLE>
    <TABLE NAME="local_orange_audience" COMMENT="Recipients using Moodle users cohorts and course groups">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="noticeid" TYPE="int" LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="targettype" TYPE="char" LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="targetid" TYPE="int" LENGTH="10" NOTNULL="true"/>
      </FIELDS>
      <KEYS><KEY NAME="primary" TYPE="primary" FIELDS="id"/><KEY NAME="notice" TYPE="foreign" FIELDS="noticeid" REFTABLE="local_orange_notice" REFFIELDS="id"/></KEYS>
      <INDEXES><INDEX NAME="target" UNIQUE="true" FIELDS="noticeid,targettype,targetid"/></INDEXES>
    </TABLE>
    <TABLE NAME="local_orange_receipt" COMMENT="Separate delivery read and explicit acknowledgement timestamps">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="noticeid" TYPE="int" LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="revision" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="1"/>
        <FIELD NAME="received" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="readtime" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="confirmed" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
      </FIELDS>
      <KEYS><KEY NAME="primary" TYPE="primary" FIELDS="id"/><KEY NAME="notice" TYPE="foreign" FIELDS="noticeid" REFTABLE="local_orange_notice" REFFIELDS="id"/></KEYS>
      <INDEXES><INDEX NAME="usernotice" UNIQUE="true" FIELDS="userid,noticeid,revision"/></INDEXES>
    </TABLE>
    <TABLE NAME="local_orange_state_log" COMMENT="Audit of changes to shared incident status">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="noticeid" TYPE="int" LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="oldstate" TYPE="char" LENGTH="20" NOTNULL="true"/>
        <FIELD NAME="newstate" TYPE="char" LENGTH="20" NOTNULL="true"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true"/>
      </FIELDS>
      <KEYS><KEY NAME="primary" TYPE="primary" FIELDS="id"/><KEY NAME="notice" TYPE="foreign" FIELDS="noticeid" REFTABLE="local_orange_notice" REFFIELDS="id"/></KEYS>
    </TABLE>
    <TABLE NAME="local_orange_revision" COMMENT="Text of each version for acknowledgement audit">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="noticeid" TYPE="int" LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="revision" TYPE="int" LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="title" TYPE="char" LENGTH="255" NOTNULL="true"/>
        <FIELD NAME="content" TYPE="text" NOTNULL="true"/>
        <FIELD NAME="authorid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true"/>
      </FIELDS>
      <KEYS><KEY NAME="primary" TYPE="primary" FIELDS="id"/><KEY NAME="notice" TYPE="foreign" FIELDS="noticeid" REFTABLE="local_orange_notice" REFFIELDS="id"/></KEYS>
      <INDEXES><INDEX NAME="noticeversion" UNIQUE="true" FIELDS="noticeid,revision"/></INDEXES>
    </TABLE>
  </TABLES>
</XMLDB>
